FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Simple accounting
VITE_LOG_LEVEL=debug

# ============================================================================
# BACKEND VARIABLES
# ============================================================================
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:Satnam%402207@localhost:5432/simple_invoicing
SECRET_KEY=dev-secret-key-change-in-productionlevmk djfj8vnfjnbd-egjv-fkn3Jdmjnvn457876r5ew3qggb,kgmndbdbdg676756456^&%^%$%&lvm 
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
