# ============================================================================
# GOOGLE MAIL (GMAIL) CONFIGURATION
# ============================================================================
# Method 1: Google Cloud Console - Gmail API (OAuth 2.0)
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REFRESH_TOKEN=
GOOGLE_MAIL_FROM_EMAIL=
GOOGLE_MAIL_FROM_NAME=Simple Invoicing

# Method 2: Google Mail SMTP (with Google Account App Password)
GOOGLE_MAIL_USER=
GOOGLE_MAIL_APP_PASSWORD=
GOOGLE_MAIL_HOST=smtp.gmail.com
GOOGLE_MAIL_PORT=587
GOOGLE_MAIL_USE_STARTTLS=true

# ============================================================================
# DATABASE VARIABLES
# ============================================================================
POSTGRES_USER=simple_user
POSTGRES_PASSWORD=simple_password
POSTGRES_DB=simple_invoicing
POSTGRES_PORT=5432

# ============================================================================
# DOCKER COMPOSE VARIABLES (for production)
# ============================================================================
COMPOSE_PROJECT_NAME=simple_invoicing

# Host-side port mappings — override locally if a port is already in use.
# These control which host port maps to each container's internal port.
# Changing these does NOT affect inter-container communication.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=80
FRONTEND_DEV_HOST_PORT=5173
