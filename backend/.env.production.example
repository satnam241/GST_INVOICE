# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ============================================================================

# Environment
ENVIRONMENT=production
DEBUG=false

# Deployment Mode:
# 'single_tenant'  -> Best for selling dedicated instances to individual clients.
#                     (Public signup disabled; Admin is created via seed_admin.py)
# 'shared_hosting' -> Best for SaaS subscription (Users self-register at /register,
#                     verify their email, create their company, and become admins).
DEPLOYMENT_MODE=single_tenant
# If shared_hosting is used on a single postgres role without RLS separation, set:
RLS_BOOT_CHECK=false

# Security Keys (CRITICAL: Change these to long random strings in production!)
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-production-key-at-least-32-chars-long
SMTP_ENCRYPTION_KEY=change-this-to-a-super-secret-smtp-encryption-key-32-chars

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URLs (Required for OAuth, Email links, Verification, MCP)
# Replace with your actual domain or VPS IP (e.g. https://billing.yourdomain.com)
PUBLIC_APP_BASE_URL=http://localhost
PUBLIC_API_BASE_URL=http://localhost/api

# ============================================================================
# GOOGLE MAIL & OAUTH CONFIGURATION
# ============================================================================
# Option 1: Google Cloud Console (OAuth 2.0 - Client ID & Secret)
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REFRESH_TOKEN=
GOOGLE_MAIL_FROM_EMAIL=
GOOGLE_MAIL_FROM_NAME=Simple Invoicing

# Option 2: Google Mail App Password (SMTP)
GOOGLE_MAIL_USER=
GOOGLE_MAIL_APP_PASSWORD=
GOOGLE_MAIL_HOST=smtp.gmail.com
GOOGLE_MAIL_PORT=587
GOOGLE_MAIL_USE_STARTTLS=true
